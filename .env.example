# 校桥 CampusBridge 环境变量配置
# 复制此文件为 .env 并填入实际值

# MySQL 数据库连接
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=campus_bridge

# Flask 密钥（生产环境请更换为随机字符串）
SECRET_KEY=dev-secret-key-change-in-production

# 腾讯云 COS 配置（可选，不填则自动使用本地存储）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=

# 文件上传限制（MB）
MAX_CONTENT_LENGTH=50
