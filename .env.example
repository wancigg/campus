# 校桥 CampusBridge 环境变量配置
# 复制此文件为 .env 并填入实际值；.env 已加入 .gitignore，不会提交到 GitHub。

# —— MySQL 主库（强制，已禁用 SQLite 降级）———————————————————————————————
# 推荐使用 MYSQL_MASTER_* 命名，语义清晰；为兼容旧部署也提供 MYSQL_* 键。
# 两套同时填时 MYSQL_MASTER_* 优先级更高。
MYSQL_MASTER_HOST=127.0.0.1
MYSQL_MASTER_PORT=3306
MYSQL_MASTER_USER=root
MYSQL_MASTER_PASSWORD=changeme
MYSQL_MASTER_DATABASE=campus_bridge

# 兼容旧部署（可留空，上面的 MYSQL_MASTER_* 已填即可）
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=

# —— MySQL 主从复制（演示型，Flask 业务只走主库；见 scripts/deploy_mysql_ms_demo.sh）
# 可选：从库连接参数，默认 127.0.0.1:3307 同机演示实例
MYSQL_SLAVE_HOST=127.0.0.1
MYSQL_SLAVE_PORT=3307
MYSQL_SLAVE_USER=root
MYSQL_SLAVE_PASSWORD=changeme
MYSQL_SLAVE_DATABASE=campus_bridge
# 复制专用账号（脚本会自动在主库创建），不要用 root
MYSQL_REPL_USER=repl
MYSQL_REPL_PASSWORD=replchangeme

# —— Flask 密钥（生产环境请更换为随机字符串，不少于 32 位）————————————
SECRET_KEY=dev-secret-key-change-in-production

# 腾讯云 COS 配置（可选，不填则自动使用本地 uploads/ 文件夹）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=

# 文件上传限制（单位 MB；同时与 Nginx client_max_body_size 保持一致）
MAX_CONTENT_LENGTH=50

# DeepSeek AI 摘要 API Key（可选，在 https://platform.deepseek.com 申请；不填自动降级为本地关键词审核）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
